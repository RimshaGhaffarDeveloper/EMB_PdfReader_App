@model List<PdfReader_App.Models.ViewModels.DesignListItemVM>

@{
    ViewBag.Title = "Design Management System";
    var totalDesigns = Model != null ? Model.Count() : 0;
    var totalStitches = Model != null ? Model.Sum(d => d.Stitches ?? 0) : 0;
    var totalColors = Model != null ? Model.Sum(d => d.Colors ?? 0) : 0;
}

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --success-gradient: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        --danger-gradient: linear-gradient(135deg, #eb3349 0%, #f45c43 100%);
        --info-gradient: linear-gradient(135deg, #2193b0 0%, #6dd5ed 100%);
    }

    body {
        background: #f8f9fa;
    }

    .page-header {
        background: var(--primary-gradient);
        color: white;
        padding: 30px;
        border-radius: 15px;
        margin-bottom: 30px;
        box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
    }

    .page-header h2 {
        margin: 0;
        font-size: 32px;
        font-weight: 700;
    }

    .page-header p {
        margin: 5px 0 0 0;
        opacity: 0.9;
    }

    /* Statistics Cards */
    .stats-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        border-radius: 15px;
        padding: 25px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    }

    .stat-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 5px;
        height: 100%;
        background: var(--primary-gradient);
    }

    .stat-card.success::before {
        background: var(--success-gradient);
    }

    .stat-card.info::before {
        background: var(--info-gradient);
    }

    .stat-icon {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        margin-bottom: 15px;
    }

    .stat-card .stat-icon {
        background: linear-gradient(135deg, #667eea22 0%, #764ba222 100%);
        color: #667eea;
    }

    .stat-card.success .stat-icon {
        background: linear-gradient(135deg, #11998e22 0%, #38ef7d22 100%);
        color: #11998e;
    }

    .stat-card.info .stat-icon {
        background: linear-gradient(135deg, #2193b022 0%, #6dd5ed22 100%);
        color: #2193b0;
    }

    .stat-label {
        color: #6c757d;
        font-size: 14px;
        font-weight: 500;
        margin-bottom: 5px;
    }

    .stat-value {
        font-size: 32px;
        font-weight: 700;
        color: #2d3748;
    }

    /* Upload Card */
    .upload-card {
        background: white;
        border-radius: 15px;
        padding: 30px;
        margin-bottom: 30px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        border: 2px dashed #e2e8f0;
        transition: all 0.3s ease;
    }

    .upload-card:hover {
        border-color: #667eea;
        box-shadow: 0 10px 30px rgba(102, 126, 234, 0.15);
    }

    .upload-card h4 {
        color: #2d3748;
        margin-bottom: 20px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .upload-icon {
        width: 40px;
        height: 40px;
        background: var(--primary-gradient);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
    }

    .btn-upload {
        background: var(--primary-gradient);
        color: white;
        font-weight: 600;
        padding: 12px 30px;
        border: none;
        border-radius: 10px;
        transition: all 0.3s ease;
    }

    .btn-upload:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(102, 126, 234, 0.3);
        color: white;
    }

    /* Table Card */
    .table-card {
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    .table-card .card-header {
        background: white;
        border-bottom: 2px solid #f1f3f5;
        padding: 20px 25px;
    }

    .table-card h5 {
        margin: 0;
        font-weight: 600;
        color: #2d3748;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .badge-count {
        background: var(--primary-gradient);
        padding: 5px 15px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 600;
    }

    .table {
        margin-bottom: 0;
    }

    .table thead th {
        background: #f8f9fa;
        color: #495057;
        font-weight: 600;
        border: none;
        padding: 15px;
        font-size: 14px;
    }

    .table tbody td {
        padding: 15px;
        vertical-align: middle;
        color: #495057;
    }

    .table tbody tr {
        transition: all 0.2s ease;
    }

    .table tbody tr:hover {
        background: #f8f9fa;
    }

    /* Modern Dropdown Actions */
    .action-dropdown {
        position: relative;
        display: inline-block;
    }

    .action-toggle {
        background: var(--primary-gradient);
        color: white;
        padding: 8px 20px;
        font-size: 14px;
        border: none;
        cursor: pointer;
        border-radius: 8px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s ease;
        font-weight: 500;
    }

    .action-toggle:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
        color: white;
        text-decoration: none;
    }

    .dropdown-content {
        display: none;
        position: absolute;
        background-color: white;
        min-width: 240px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.15);
        z-index: 1000;
        border-radius: 12px;
        right: 0;
        top: 100%;
        margin-top: 8px;
        padding: 8px 0;
        animation: slideDown 0.3s ease;
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .dropdown-content.show {
        display: block;
    }

    .dropdown-content a {
        color: #495057;
        padding: 12px 20px;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 12px;
        transition: all 0.2s ease;
        font-size: 14px;
    }

    .dropdown-content a i {
        width: 20px;
        text-align: center;
        font-size: 16px;
    }

    .dropdown-content a:hover {
        background: linear-gradient(to right, #f8f9fa 0%, #e9ecef 100%);
        padding-left: 25px;
    }

    .dropdown-content a.text-danger:hover {
        background: linear-gradient(to right, #fff5f5 0%, #ffe5e5 100%);
        color: #dc3545 !important;
    }

    .dropdown-content a.image-preview {
        color: #17a2b8;
    }

    .dropdown-content a.image-preview:hover {
        background: linear-gradient(to right, #e7f8fb 0%, #d1f2f8 100%);
        color: #0c8599 !important;
    }

    .text-danger {
        color: #dc3545 !important;
    }

    .dropdown-divider {
        height: 0;
        margin: 8px 0;
        overflow: hidden;
        border-top: 1px solid #e9ecef;
    }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
    }

    .empty-state i {
        color: #cbd5e0;
        margin-bottom: 20px;
    }

    .empty-state p {
        color: #a0aec0;
        font-size: 16px;
    }

    /* Alerts */
    .alert {
        border-radius: 12px;
        border: none;
        padding: 15px 20px;
        margin-bottom: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }

    .alert-success {
        background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);
        color: #155724;
    }

    .alert-danger {
        background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%);
        color: #721c24;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .stats-container {
            grid-template-columns: 1fr;
        }
    }
    .dashboard-row {
    display: flex;
    gap: 20px;
    align-items: stretch;
}

.stats-container {
    flex: 1;
}

.upload-card {
    flex: 2;   /* upload thora wide ho jaye */
}

/* Mobile responsive */
@@media (max-width: 768px) {
    .dashboard-row {
        flex-direction: column;
    }
}

</style>

<div class="container-fluid mt-4">

    <!-- Page Header -->
    <div class="page-header">
        <h2><i class="fa fa-file-pdf-o"></i> Design Management System</h2>
        <p>Upload, manage and preview your embroidery designs</p>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible">
            <button type="button" class="close" data-dismiss="alert">&times;</button>
            <i class="fa fa-check-circle"></i> <strong>Success!</strong> @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible">
            <button type="button" class="close" data-dismiss="alert">&times;</button>
            <i class="fa fa-exclamation-triangle"></i> <strong>Error!</strong> @TempData["Error"]
        </div>
    }

    <div class="dashboard-row">

        <!-- Statistics Cards -->
        <div class="stats-container">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fa fa-file-pdf-o"></i>
                </div>
                <div class="stat-label">Total Designs</div>
                <div class="stat-value">@totalDesigns</div>
            </div>
        </div>

        <!-- Upload Section -->
        <div class="upload-card">
            <h4>
                <div class="upload-icon">
                    <i class="fa fa-cloud-upload"></i>
                </div>
                Upload New Design
            </h4>

            @using (Html.BeginForm("UploadPdf", "Design", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                <div class="row align-items-center">
                    <div class="col-md-9">
                        <input type="file"
                               name="pdfFile"
                               class="form-control form-control-lg"
                               accept=".pdf"
                               required />
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-upload btn-lg btn-block">
                            <i class="fa fa-upload"></i> Upload & Preview
                        </button>
                    </div>
                </div>
            }
        </div>

    </div>


    <!-- Designs Table -->
    <div class="card table-card">
        <div class="card-header">
            <h5>
                <i class="fa fa-list"></i>
                Saved Designs
                <span class="badge badge-count ml-2">@totalDesigns</span>
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th><i class="fa fa-code"></i> Design Code</th>
                            <th><i class="fa fa-tag"></i> Design Name</th>
                            <th><i class="fa fa-arrows-h"></i> Width (mm)</th>
                            <th><i class="fa fa-arrows-v"></i> Height (mm)</th>
                            <th><i class="fa fa-palette"></i> Colors</th>
                            <th><i class="fa fa-dot-circle-o"></i> Stitches</th>
                            <th><i class="fa fa-cog"></i> Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var d in Model)
                            {
                                <tr>
                                    <td><strong style="color: #667eea;">@d.DesignCode</strong></td>
                                    <td>@d.DesignName</td>
                                    <td>@(d.WidthMM != null ? ((decimal)d.WidthMM).ToString("0.#") : "-")</td>
                                    <td>@(d.HeightMM != null ? ((decimal)d.HeightMM).ToString("0.#") : "-")</td>
                                    <td>

                                        @(d.Colors ?? 0)

                                    </td>
                                    <td>@(d.Stitches != null ? ((int)d.Stitches).ToString("N0") : "-")</td>
                                    <td>
                                        <!-- Modern Dropdown -->
                                        <div class="action-dropdown">
                                            <a href="javascript:void(0);"
                                               class="action-toggle"
                                               onclick="toggleDropdown(event, 'dropdown_@d.Id')">
                                                <i class="fa fa-bars"></i>
                                                Views
                                                <i class="fa fa-caret-down"></i>
                                            </a>
                                            <div class="dropdown-content" id="dropdown_@d.Id">
                                                <a href="@Url.Action("Preview", "Design", new { designId = d.Id })">
                                                    <i class="fa fa-eye"></i> Full Preview
                                                </a>
                                                <a href="@Url.Action("ViewDesignImage", "Design", new { designId = d.Id })"
                                                   target="_blank"
                                                   class="image-preview">
                                                    <i class="fa fa-picture-o"></i> View Image
                                                </a>
                                                <div class="dropdown-divider"></div>
                                                <a href="@Url.Action("DesignDetailsView", "Design", new { designId = d.Id })">
                                                    <i class="fa fa-info-circle"></i> Design Details
                                                </a>
                                                <a href="@Url.Action("MachineInfoView", "Design", new { designId = d.Id })">
                                                    <i class="fa fa-cog"></i> Machine Info
                                                </a>
                                                <a href="@Url.Action("StopSequenceView", "Design", new { designId = d.Id })">
                                                    <i class="fa fa-list-ol"></i> Stop Sequences
                                                </a>
                                                <a href="@Url.Action("SequinView", "Design", new { designId = d.Id })">
                                                    <i class="fa fa-diamond"></i> Sequins
                                                </a>
                                                <a href="@Url.Action("ThreadUsageView", "Design", new { designId = d.Id })">
                                                    <i class="fa fa-slack"></i> Thread Usage
                                                </a>
                                                <div class="dropdown-divider"></div>
                                                <a href="@Url.Action("Delete", "Design", new { id = d.Id })"
                                                   class="text-danger"
                                                   onclick="return confirm('Are you sure you want to delete this design?');">
                                                    <i class="fa fa-trash"></i> Delete Design
                                                </a>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="empty-state">
                                    <i class="fa fa-inbox fa-4x"></i>
                                    <p>No designs found. Upload your first PDF to get started!</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        // Auto-dismiss alerts
        setTimeout(function () {
            $('.alert').fadeOut('slow');
        }, 5000);

        // Dropdown toggle
        function toggleDropdown(event, dropdownId) {
            event.preventDefault();
            event.stopPropagation();

            // Close all other dropdowns
            document.querySelectorAll('.dropdown-content').forEach(function (dropdown) {
                if (dropdown.id !== dropdownId) {
                    dropdown.classList.remove('show');
                }
            });

            // Toggle current
            document.getElementById(dropdownId).classList.toggle('show');
        }

        // Close on outside click
        window.onclick = function (event) {
            if (!event.target.matches('.action-toggle') && !event.target.closest('.action-toggle')) {
                document.querySelectorAll('.dropdown-content').forEach(function (dropdown) {
                    dropdown.classList.remove('show');
                });
            }
        }
    </script>
}