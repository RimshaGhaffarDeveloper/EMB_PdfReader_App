@model List<PdfReader_App.Models.ViewModels.SequinVM>

@{
    ViewBag.Title = "Sequins";
}

<div class="container mt-4">

    <!-- Header -->
    <div class="card shadow-sm mb-3">
        <div class="card-header sequin-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0">
                <i class="fa fa-diamond"></i>
                Sequins Information
            </h4>
            <span class="badge bg-light text-dark">
                Design Code: @ViewBag.DesignCode
            </span>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card shadow-sm">
        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table sequin-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Shape</th>
                                <th>Size (mm)</th>
                                <th>Count</th>
                                <th>Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int seqNo = 1; }
                            @foreach (var sequin in Model)
                            {
                                <tr>
                                    <td><strong>@seqNo</strong></td>
                                    <td>@sequin.Shape</td>
                                    <td>@(sequin.Size?.ToString("F1"))</td>
                                    <td>@sequin.Count</td>
                                    <td>@sequin.Name</td>
                                </tr>
                                seqNo++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-secondary text-center">
                    <i class="fa fa-info-circle"></i>
                    No sequins found for this design.
                </div>
            }

            <!-- Actions -->
            <div class="mt-4 d-flex justify-content-between">
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                    <i class="fa fa-arrow-left"></i> Back to List
                </a>
                <a href="@Url.Action("Preview", new { designId = ViewBag.DesignId })"
                   class="btn btn-purple">
                    <i class="fa fa-eye"></i> Full Preview
                </a>
            </div>

        </div>
    </div>
</div>
<style>

    /* Header */
    .sequin-header {
        background: linear-gradient(135deg, #6f42c1, #5a2d9c);
        color: #fff;
        border-radius: 8px;
    }

    /* Table */
    .sequin-table {
        border-collapse: separate;
        border-spacing: 0;
    }

        .sequin-table thead th {
            background: #f3ecff;
            color: #4b2c83;
            font-weight: 600;
            border-bottom: 2px solid #d6c7f7;
        }

        .sequin-table tbody tr {
            transition: background 0.2s ease;
        }

            .sequin-table tbody tr:hover {
                background: #f8f5ff;
            }

        .sequin-table td,
        .sequin-table th {
            padding: 10px 12px;
            border-bottom: 1px solid #e7ddfb;
        }

    /* Purple button */
    .btn-purple {
        background: #6f42c1;
        color: #fff;
    }

        .btn-purple:hover {
            background: #5a2d9c;
            color: #fff;
        }

</style>