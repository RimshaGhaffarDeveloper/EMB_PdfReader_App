@model List<PdfReader_App.Models.ViewModels.ThreadUsageVM>

@{
    ViewBag.Title = "Thread Usage";
}

<div class="container mt-4">

    <!-- Header -->
    <div class="card shadow-sm mb-4">
        <div class="card-header thread-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0">
                <i class="fa fa-slack"></i>
                Thread Usage
            </h4>
            <span class="badge design-badge">
                @ViewBag.DesignCode
            </span>
        </div>
    </div>

    <!-- Table -->
    <div class="card shadow-sm">
        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table thread-table">
                        <thead>
                            <tr>
                                <th>Needle</th>
                                <th>Color Code</th>
                                <th>Color Name</th>
                                <th class="text-end">Thread Length (m)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var thread in Model)
                            {
                                <tr>
                                    <td><strong>@thread.NeedleNo</strong></td>
                                    <td>@thread.Code</td>
                                    <td>@thread.Name</td>
                                    <td class="text-end">
                                        @(thread.Length?.ToString("F2"))
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="total-row">
                                <th colspan="3" class="text-end">Total Length</th>
                                <th class="text-end">
                                    @Model.Sum(t => t.Length ?? 0).ToString("F2")
                                </th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-secondary text-center">
                    <i class="fa fa-info-circle"></i>
                    No thread usage data found for this design.
                </div>
            }

            <!-- Actions -->
            <div class="mt-4 d-flex justify-content-between">
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                    <i class="fa fa-arrow-left"></i> Back
                </a>

                <a href="@Url.Action("Preview", new { designId = ViewBag.DesignId })"
                   class="btn btn-purple">
                    <i class="fa fa-eye"></i> Full Preview
                </a>
            </div>

        </div>
    </div>

</div>
<style>

    .thread-header {
        background: linear-gradient(135deg, #6f42c1, #5a2d9c);
        color: #fff;
        border-radius: 10px;
    }

    .thread-table {
        border-collapse: separate;
        border-spacing: 0;
    }

        .thread-table thead th {
            background: #f3ecff;
            color: #4b2c83;
            font-weight: 600;
            border-bottom: 2px solid #d9c9fb;
            white-space: nowrap;
        }

        .thread-table td,
        .thread-table th {
            padding: 10px 12px;
            border-bottom: 1px solid #eee4ff;
            vertical-align: middle;
        }

        .thread-table tbody tr:hover {
            background: #faf7ff;
        }

    .total-row {
        background: #f8f5ff;
        font-weight: 600;
        color: #4b2c83;
    }

    .design-badge {
        background: #f3ecff;
        color: #4b2c83;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: 20px;
    }

    .btn-purple {
        background: #6f42c1;
        color: #fff;
    }

        .btn-purple:hover {
            background: #5a2d9c;
            color: #fff;
        }

</style>